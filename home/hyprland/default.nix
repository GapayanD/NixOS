{ inputs, pkgs, ... }:
let
  hyprspace = inputs.Hyprspace.packages.${pkgs.stdenv.hostPlatform.system}.Hyprspace;
in
{
  # Hyprland is installed and registered as a session by the NixOS module.
  # The current Hyprland Lua config is managed as separate files here instead
  # of asking Home Manager to generate a legacy hyprland.conf.
  home.file.".config/hypr/hyprland.lua".source = ./hyprland.lua;
  home.file.".config/hypr/conf/appearance.lua".source = ./conf/appearance.lua;
  home.file.".config/hypr/conf/keybinds.lua".source = ./conf/keybinds.lua;
  home.file.".config/hypr/conf/window-rules.lua".source = ./conf/window-rules.lua;
  home.file.".config/hypr/conf/workspaces.lua".source = ./conf/workspaces.lua;

  # Generated (not a static file) because the plugin path is a Nix store path.
  home.file.".config/hypr/conf/plugins.lua".text = ''
    -- Generated by home/hyprland/default.nix. Do not edit in ~/.config.
    -- Plugins must be loaded BEFORE their plugin.<name> config keys are set.
    local plugins = {
      "${hyprspace}/lib/libHyprspace.so",
    }

    for _, path in ipairs(plugins) do
      hl.plugin.load(path)
    end

    -- Hyprspace: workspace overview (toggled with Super+Tab in keybinds.lua).
    -- Guarded so a failed plugin load does not also throw on the config keys.
    if hl.plugin and hl.plugin.overview then
      hl.config({
        plugin = {
          overview = {
            autoDrag = true,
            exitOnClick = true,
            switchOnDrop = true,
            exitOnSwitch = true,
            -- Workspaces 1-10 are persistent, so show them all but skip the
            -- extra "new workspace" slot.
            showEmptyWorkspace = true,
            showNewWorkspace = false,
          },
        },
      })
    end
  '';
}
